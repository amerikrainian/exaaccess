<Project Sdk="Microsoft.NET.Sdk">

  <!-- The RELOADABLE half of the mod: every feature (announcers, localization, input, UI graph)
       lives here. The host (ExaAccess.dll, ../ExaAccess.csproj) byte-loads this dll via
       Modularity/ModuleLoader, so the file is never locked — rebuild with the game running, then
       POST /reload (or F6 in a Debug build) hot-swaps the features without a game restart or
       another trip through the boot click-gate. See src/Modularity/IModModule.cs for the rules. -->

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>ExaAccess.Module</AssemblyName>
    <RootNamespace>ExaAccess</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\EXAPUNKS</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- The host: shared statics (Log, GameState, Tts, MemberResolver) and the module contract.
         Private=false — the host deploys itself; we ship only ExaAccess.Module.dll from here. -->
    <ProjectReference Include="..\ExaAccess.csproj" Private="false" />
    <!-- Module-owned Harmony patches (per-load unique id + UnpatchSelf — see IModModule). -->
    <Reference Include="0Harmony">
      <HintPath>..\third_party\harmony\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- In-box framework assembly (nothing shipped): locale JSON parsing. -->
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ExaAccess.Tests" />
  </ItemGroup>

  <!-- Byte-loaded means never file-locked: this copy succeeds even while the game is running.
       That IS the hot-reload loop — build, then /reload. -->
  <Target Name="DeployModule" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <Copy SourceFiles="$(OutputPath)ExaAccess.Module.dll" DestinationFolder="$(GameDir)" />
    <!-- Locale tables land under <game>\ExaAccess\locale\<lang>\*.json (the module is byte-loaded
         and has no disk location, so LocalizationManager roots off the host dll's folder). A module
         hot-reload re-reads them: edit a string, build, /reload, hear it. -->
    <ItemGroup>
      <LocaleFiles Include="$(MSBuildProjectDirectory)\assets\locale\**\*.json" />
    </ItemGroup>
    <Copy SourceFiles="@(LocaleFiles)"
          DestinationFiles="@(LocaleFiles->'$(GameDir)\ExaAccess\locale\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Importance="high" Text="ExaAccess.Module + locale deployed to $(GameDir)" />
  </Target>

</Project>
