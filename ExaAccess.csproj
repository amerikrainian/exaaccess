<Project Sdk="Microsoft.NET.Sdk">

  <!-- ExaAccess — screen-reader accessibility mod for EXAPUNKS (Zachtronics).
       EXAPUNKS is a single, self-contained .NET Framework 4.x x64 executable ("Burbank")
       running Zachtronics' own SDL2/D3D11 engine — NOT Unity. So there is no Unity player to
       bootstrap into: this project builds a small LOADER exe that Assembly.LoadFrom's the game,
       applies Harmony patches BEFORE the game's entry point runs, boots speech, then invokes the
       game's entry point in-process. See README.md for the full rationale (and why not BepInEx). -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <!-- The game is x64; we host it in-process, so we must match its architecture exactly. -->
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>ExaAccess</AssemblyName>
    <RootNamespace>ExaAccess</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Never compile the decompiled game tree (game/, gitignored) or the vendored libraries into
       the loader. game/ holds hundreds of .cs files that the default SDK glob would otherwise pull in. -->
  <ItemGroup>
    <Compile Remove="game/**/*.cs" />
    <None Remove="game/**" />
    <Compile Remove="third_party/**/*.cs" />
  </ItemGroup>

  <!-- Paths. Override GameDir on the command line if your install differs:
       dotnet build -p:GameDir="D:\...\EXAPUNKS" -->
  <PropertyGroup>
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\EXAPUNKS</GameDir>
    <SteamAppId>716490</SteamAppId>
    <ThirdParty>$(MSBuildProjectDirectory)\third_party</ThirdParty>
  </PropertyGroup>

  <ItemGroup>
    <!-- Harmony 2.4.2 (net48, MIT) — vendored in third_party/harmony. This is the ONLY runtime
         dependency besides prism.dll needed to play: it ships next to the loader (Private=true). -->
    <Reference Include="0Harmony">
      <HintPath>$(ThirdParty)\harmony\0Harmony.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- Mono.CSharp powers the DEBUG-only dev server's /eval REPL (live introspection of the
       obfuscated game). The dev server is all #if DEBUG, so a Release build neither compiles
       against nor ships this. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <Reference Include="Mono.CSharp">
      <HintPath>$(ThirdParty)\monocsharp\Mono.CSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- Deploy into the game folder after a Debug build; then launch ExaAccess.exe (see README). -->
  <Target Name="DeployMod" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <ItemGroup>
      <Payload Include="$(OutputPath)ExaAccess.exe" />
      <Payload Include="$(OutputPath)0Harmony.dll" />
      <!-- Native screen-reader bridge (Prism → NVDA/JAWS/SAPI/OneCore). Must sit next to the exe
           whose working dir is the game folder so P/Invoke can resolve it. -->
      <Payload Include="$(ThirdParty)\prism\prism.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(Payload)" DestinationFolder="$(GameDir)" />
    <!-- Mono.CSharp for the DEBUG-only /eval; harmless to place next to the game. -->
    <Copy SourceFiles="$(ThirdParty)\monocsharp\Mono.CSharp.dll" DestinationFolder="$(GameDir)"
          Condition="'$(Configuration)' == 'Debug'" />
    <!-- steam_appid.txt so a direct launch of ExaAccess.exe is accepted by Steamworks and NOT
         bounced back to the vanilla exe by SteamAPI.RestartAppIfNecessary (GameLogic.method_8).
         The loader also writes this at runtime as a fallback. -->
    <WriteLinesToFile File="$(GameDir)\steam_appid.txt" Lines="$(SteamAppId)" Overwrite="true" />
    <Message Importance="high" Text="ExaAccess deployed to $(GameDir)" />
  </Target>

</Project>
