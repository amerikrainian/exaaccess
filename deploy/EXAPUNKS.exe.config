<?xml version="1.0" encoding="utf-8"?>
<!-- ExaAccess zero-loader hookup. Placed next to EXAPUNKS.exe, this makes the CLR instantiate
     ExaAccess.Bootstrap (our AppDomainManager) inside the stock game process before any game code
     runs — see src/Bootstrap.cs. EXAPUNKS ships no .exe.config of its own, so this file is purely
     additive; delete it to launch fully vanilla. The assembly display name below must match the
     built ExaAccess assembly exactly — AssemblyVersion is pinned to 1.0.0.0 in ExaAccess.csproj
     for that reason. -->
<configuration>
  <runtime>
    <appDomainManagerAssembly value="ExaAccess, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null" />
    <appDomainManagerType value="ExaAccess.Bootstrap" />
  </runtime>
</configuration>
