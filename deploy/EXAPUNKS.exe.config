<?xml version="1.0" encoding="utf-8"?>
<!-- Echopunks zero-loader hookup. Placed next to EXAPUNKS.exe, this makes the CLR instantiate
     Echopunks.Bootstrap (our AppDomainManager) inside the stock game process before any game code
     runs — see src/Bootstrap.cs. EXAPUNKS ships no .exe.config of its own, so this file is purely
     additive; delete it to launch fully vanilla. The assembly display name below must match the
     built Echopunks assembly exactly — AssemblyVersion is pinned to 1.0.0.0 in Echopunks.csproj
     for that reason. -->
<configuration>
  <runtime>
    <appDomainManagerAssembly value="Echopunks, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null" />
    <appDomainManagerType value="Echopunks.Bootstrap" />
  </runtime>
</configuration>
